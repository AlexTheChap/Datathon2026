# Copy to .env at the repo root (git-ignored, never commit it) and paste the AWS account credentials
# (e.g. workshop "Get AWS CLI credentials"). The real environment (export AWS_...) always wins over this file.
# Read by app/core/config.py, scripts/demo_pipeline.py --mode bedrock, scripts/deploy_*_lambda.py.

# --- AWS (Bedrock, AgentCore, Lambda deploys) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (access key starting with ASIA); leave empty otherwise.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Values only: no quotes needed, and no comment on the same line as a value.

# --- Fitfolio overrides (optional: uncomment to use) ---
# Box 5 orchestrator settings (app/core/config.py): region, main model, AgentCore Memory id
# AF_AWS_REGION=us-east-1
# AF_MODEL_ORCHESTRATOR=us.anthropic.claude-sonnet-5-5
# AF_MEMORY_ID=   (create it: .venv/bin/python scripts/agentcore_memory.py create --write-env)
# Reference date of a run when the request gives none (empty = the last date of data/curated, never a constant)
# AF_DEFAULT_AS_OF=
# Box 2 API: how a run reaches box 5. inline (default) = the orchestrator + Explainer run before the
# POST returns (live answer, no queue); local = in a background thread after the 202; none = the run
# stays QUEUED with its plan only.
# AF_DISPATCH=inline
# Dated news corpus read by the news_search tool (built by scripts/ingest_news.py)
# AF_NEWS_DIR=data/external/news
# Box 3 intake: model and optional Bedrock Guardrails on the input
# AF_INTAKE_MODEL=us.anthropic.claude-haiku-5-5
# How plan-enabled sub-agents run: graph (default, parallel fork/join) | tools (serial delegation).
# AF_ORCHESTRATION=graph
# mock (default, offline) | bedrock (in-process) | lambda (the API invokes the deployed alphaforge-intake function)
# AF_INTAKE_MODE=lambda
# AF_INTAKE_FUNCTION=alphaforge-intake
# AF_GUARDRAIL_ID=
# Same guardrail checks the Explainer's answer (grounding per statement, L18). Created by scripts/deploy_guardrail.py
# (--write-env fills both lines). AF_OUTPUT_GUARDRAIL=false keeps the input filter but turns off the output check.
# AF_GUARDRAIL_VERSION=DRAFT
# AF_OUTPUT_GUARDRAIL=true
# Sign-in: on by default, settings in backend/app/core/signin.json (tracked). AF_COGNITO_REGION /
# AF_COGNITO_USER_POOL_ID / AF_COGNITO_CLIENT_ID override them; AF_AUTH_MODE=dev = no-password local tests only.
# AF_DEMO_PASSWORD=          (written by scripts/setup_cognito.py: the one-click demo accounts)
# Box 4 Explainer templates: local (repo files) or s3 (bucket created by scripts/deploy_context_lambda.py)
# AF_PROMPT_SOURCE=s3
# AF_PROMPT_BUCKET=
# AF_PROMPT_PREFIX=prompts/
# Box 4 context resolution: local (default, in-process) | lambda (the API invokes the deployed alphaforge-context)
# AF_CONTEXT_MODE=lambda
# AF_CONTEXT_FUNCTION=alphaforge-context
# News alerts by SMS (scripts/deploy_sms_alerts.py): the SEC requires a contact in the User-Agent;
# AF_APP_URL is the optional link added to each text
# AF_SEC_CONTACT="Fitfolio Datathon you@example.com"
# AF_APP_URL=

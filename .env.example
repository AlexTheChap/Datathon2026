# Copier ce fichier en .env (à la racine) et remplir les valeurs.
# .env est ignoré par git (voir .gitignore) — ne jamais le committer.
# L'environnement réel (export AWS_…) prime toujours sur ce fichier.

# --- AWS (pour Bedrock / AgentCore) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=        # seulement pour des identifiants temporaires
AWS_DEFAULT_REGION=us-east-1

# --- AlphaForge (AF_*) ---
# AF_MODEL_ORCHESTRATOR=anthropic.claude-sonnet-4-5-v1:0
# AF_AWS_REGION=us-east-1
# AF_MEMORY_ID=             # AgentCore Memory (scripts/setup_memory.py)

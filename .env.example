# Copy to .env (git-ignored) and paste the credentials of the AWS account (e.g. workshop "Get AWS CLI credentials").
# Read by scripts/demo_pipeline.py --mode bedrock and scripts/deploy_context_lambda.py. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

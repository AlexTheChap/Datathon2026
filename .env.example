# Copy to .env at the repo root (git-ignored, never commit it). Values only: no quotes, no comment on a value's line.
# The real environment (export AWS_...) always wins over this file. NEVER put real values in THIS file: it is tracked.

# --- AWS credentials (Bedrock, AgentCore, deploys) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (access key starting with ASIA).
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# --- Fitfolio resources: each line is written by the script named after it ---
# Bedrock Knowledge Base of the news corpus (scripts/deploy_news_kb.py)
AF_KB_ID=
# AgentCore Gateway (MCP) URL of the quant tools (scripts/deploy_quant_gateway.py)
AF_GATEWAY_URL=
# Bedrock Guardrail on the intake input and the Explainer's answer (scripts/deploy_guardrail.py --write-env)
AF_GUARDRAIL_ID=
AF_GUARDRAIL_VERSION=
# AgentCore Memory: chat memory (scripts/agentcore_memory.py create --write-env)
AF_MEMORY_ID=
# Shared password of the demo accounts (scripts/setup_cognito.py)
AF_DEMO_PASSWORD=
# SEC contact for the news-alert User-Agent, required by the SEC (scripts/deploy_sms_alerts.py)
AF_SEC_CONTACT=Fitfolio Datathon you@example.com

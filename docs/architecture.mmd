%% =====================================================================================
%% AlphaForge — architecture des agents (schéma v2)
%% Les liaisons et les nœuds sont INCHANGÉS. Les lignes « %% » sont des commentaires :
%% Mermaid ne les affiche pas. Elles indiquent, pour chaque liaison, les outils AWS utilisés.
%% Glossaire des outils AWS (1-2 lignes chacun) : en bas de ce fichier.
%% Détail et alternatives : docs/AWS.md · Explication lien par lien : docs/ARCHITECTURE.md
%% Légende couleurs : orange = service AWS · vert = agent LLM · bleu = code déterministe
%%                    violet = données JSON · blanc = interface
%% =====================================================================================
flowchart TB
  %% ===== 1. Frontend =====
  %% AWS : ECS sur Fargate (recommandé : ECS Express Mode) · ALB · Cognito · S3 (URL présignées)
  UI["① Frontend — Streamlit on ECS Fargate · Cognito login<br/>chat · profile form · file upload (presigned S3 URL)"]

  %% ===== 2. API =====
  %% AWS : API Gateway (HTTP API + autorisateur JWT Cognito) · Lambda (FastAPI + Mangum)
  API["② API Gateway HTTP + Lambda (FastAPI)<br/>POST /v1/runs → 202 run_id · GET /v1/runs/id"]

  %% ===== 3. Intake =====
  %% AWS : Bedrock (Claude Haiku, API Converse + structured outputs JSON Schema) · Guardrails (entrée)
  subgraph INTAKE["③ Intake — Bedrock Haiku, structured output (Pydantic)"]
    ING["Intake agent (ingester)<br/>free text → validated JSON"]
    PROF[/"Profile JSON<br/>risk band · horizon · ESG / crypto prefs<br/>language · experience · agent toggles"/]
    REQ[/"Request JSON<br/>task · assets · weights · capital · as_of"/]
  end

  %% ===== 4. Context =====
  %% AWS : Lambda (code Python pur) · S3 ou Bedrock Prompt Management (gabarits versionnés)
  subgraph CTX["④ Context resolution — deterministic code, no LLM"]
    PLAN{{"Plan resolver<br/>task × profile × toggles → enabled sub-agents"}}
    LOAD{{"Prompt loader<br/>base prompts by language · experience · role<br/>(versioned agent.md templates in S3)"}}
  end

  %% ===== 5. Agents =====
  %% AWS : Bedrock AgentCore Runtime (héberge le graphe Strands) · Bedrock (Sonnet, Haiku) · AgentCore Memory
  subgraph RT["⑤ Amazon Bedrock AgentCore Runtime — Strands graph"]
    ORCH["Main agent · orchestrator<br/>Claude Sonnet"]
    MEM[("AgentCore Memory<br/>session · soft preferences")]
    subgraph SUB["Sub-agents · Claude Haiku · only the ones in the plan (run in parallel)"]
      RISK["Risk"]
      NEWS["News"]
      ESG["ESG"]
      FUND["Fundamentals"]
      MACRO["Macro & scenarios"]
      ALLOC["Allocation"]
    end
    GOV["Governance agent<br/>rules YAML → PASS / WARN / BLOCK"]
    EXP["Explainer agent · Claude Sonnet<br/>cites evidence only + claim verifier"]
  end

  %% ===== 6. Tools & data =====
  %% AWS : AgentCore Gateway (MCP) · Lambda · Bedrock Knowledge Bases · S3 Vectors · S3 · DynamoDB
  subgraph DATA["⑥ Tools & data"]
    GW["AgentCore Gateway (MCP)<br/>Lambda quant tools: metrics · risk · scenarios · optimizer"]
    KB["Bedrock Knowledge Base<br/>news & docs · S3 Vectors"]
    S3[("S3 curated Parquet<br/>prices · FX · macro · point-in-time")]
    DDB[("DynamoDB<br/>profiles · runs · evidence ledger")]
  end

  %% AWS : même service frontend (ECS) ; lit le résultat via API Gateway + Lambda
  OUT["⑦ Frontend result view<br/>short answer · clickable evidence · checks · trace"]

  %% ===== Cross-cutting =====
  %% AWS : Bedrock Guardrails · AgentCore Observability → CloudWatch (GenAI observability) · IAM
  X["Cross-cutting: Bedrock Guardrails (inputs & outputs) · AgentCore Observability → CloudWatch · IAM least privilege"]

  %% ===== Flow =====
  %% L1  UI → API : Cognito émet le JWT ; l'autorisateur JWT d'API Gateway le valide avant la Lambda.
  %%      Les fichiers vont directement dans S3 par URL présignée (jamais par Lambda, limite 6 Mo).
  UI -->|"JWT"| API
  %% L2  API → Intake : Lambda appelle Bedrock (Haiku) via Converse avec structured outputs (schéma JSON).
  %%      Guardrails filtre l'entrée (attaque d'invite, données personnelles).
  API --> ING
  %% L3  Intake → JSON : sortie validée par schéma (Bedrock structured outputs) puis Pydantic ;
  %%      le profil est enregistré dans DynamoDB (ACTOR#… / PROFILE#…).
  ING --> PROF
  ING --> REQ
  %% L4  JSON → Plan resolver : Lambda, code Python pur ; registre agents/tâches versionné (repo, ou AWS AppConfig en option).
  PROF --> PLAN
  REQ --> PLAN
  %% L5  Profile → Prompt loader : Lambda ; choisit le gabarit de l'Explainer (langue × niveau). Source : Git
  %%      (agents/prompts/), publié dans S3 en mode aws (AF_PROMPT_SOURCE) ; option : Bedrock Prompt Management.
  PROF --> LOAD
  %% L6  Plan → Orchestrator : DynamoDB (run QUEUED) → Lambda « dispatcher » (invocation asynchrone)
  %%      → AgentCore Runtime (InvokeAgentRuntime). Frontière API / agents ; IAM pour l'appel.
  PLAN -->|"ExecutionPlan"| ORCH
  %% L7  Prompt loader → Explainer : seules des clés voyagent (langue, niveau, version) dans le payload
  %%      InvokeAgentRuntime ; le Runtime charge le gabarit depuis S3 / Prompt Management.
  LOAD -.->|"prompts"| EXP
  %% L8  Orchestrator → Sub-agents : graphe Strands dans AgentCore Runtime ; modèles Bedrock (Haiku) ;
  %%      seuls les agents du plan deviennent des nœuds, en parallèle.
  ORCH -->|"dispatch"| SUB
  %% L9  Sub-agents → Governance : en mémoire dans le Runtime ; règles Python (YAML) ; aucun service externe.
  SUB -->|"findings"| GOV
  %% L10 Governance → Orchestrator : arête conditionnelle du graphe Strands (max 2 boucles), dans le Runtime.
  GOV -->|"BLOCK → fix (max 2 loops)"| ORCH
  %% L11 Governance → Explainer : dans le Runtime ; constats codés + contrôles + agents désactivés.
  GOV -->|"PASS / WARN"| EXP
  %% L12 Sub-agents → Gateway : AgentCore Gateway (MCP, auth SigV4/OAuth, option Policy Cedar)
  %%      → Lambda d'outils quant.
  SUB -->|"tool calls"| GW
  %% L13 News → KB : Bedrock Knowledge Bases (API Retrieve + filtre de métadonnées published ≤ as_of),
  %%      index S3 Vectors, embeddings Titan Text Embeddings v2.
  NEWS -->|"RAG · published ≤ as_of"| KB
  %% L14 Gateway → S3 : les Lambdas d'outils lisent le Parquet (pandas/DuckDB, filtre point-in-time).
  %%      Glue + Athena servent à l'exploration, pas à cette boucle.
  GW --> S3
  %% L15 Gateway → DynamoDB : en pratique, un hook Strands (AfterToolCallEvent) dans le Runtime écrit
  %%      chaque résultat d'outil comme preuve (RUN#id / EVID#E-001).
  GW -->|"each call = 1 evidence"| DDB
  %% L16 DynamoDB → Explainer : lecture (Query) du registre de preuves via l'outil get_evidence.
  DDB -.->|"evidence ledger"| EXP
  %% L17 Orchestrator ↔ Memory : AgentCore Memory (court terme : session ; long terme : préférences
  %%      par actorId) via le session manager Strands.
  ORCH <-.-> MEM
  %% L18 Explainer → DynamoDB : RunResult écrit (S3 si > 400 Ko) ; vérification d'ancrage Guardrails
  %%      sur la réponse courte.
  EXP -->|"RunResult"| DDB
  %% L19 Explainer → Result view : en réalité le frontend interroge GET /v1/runs/{id} (API Gateway + Lambda
  %%      qui lit DynamoDB). Option : API Gateway REST avec streaming de réponse (SSE) pour la progression.
  EXP -->|"GET /v1/runs/id (poll)"| OUT

  classDef aws fill:#fff4e5,stroke:#e88a1a,color:#1f1f1f;
  classDef det fill:#eaf2ff,stroke:#3b6fd8,color:#1f1f1f;
  classDef agent fill:#eaf8ee,stroke:#2f9e55,color:#1f1f1f;
  classDef json fill:#f6f0ff,stroke:#8a63d2,color:#1f1f1f;
  classDef ui fill:#ffffff,stroke:#555,color:#1f1f1f;
  class API,GW,KB,S3,DDB,MEM,X aws;
  class PLAN,LOAD det;
  class ING,ORCH,RISK,NEWS,ESG,FUND,MACRO,ALLOC,GOV,EXP agent;
  class PROF,REQ json;
  class UI,OUT ui;

%% =====================================================================================
%% GLOSSAIRE DES OUTILS AWS (synthèse ; détails, régions et alternatives : docs/AWS.md)
%% -------------------------------------------------------------------------------------
%% Amazon ECS sur Fargate : exécute des conteneurs sans gérer de serveurs. Héberge Streamlit.
%%   ECS Express Mode crée en un appel le service Fargate, l'ALB, l'URL HTTPS et l'autoscaling.
%% Application Load Balancer (ALB) : répartit le trafic HTTPS vers le conteneur Streamlit.
%% Amazon Cognito : annuaire d'utilisateurs ; émet les jetons JWT (identité pseudonyme = actor_id).
%% Amazon S3 : stockage d'objets. Fichiers importés (URL présignées), Parquet curé, gabarits de prompts.
%% Amazon API Gateway (HTTP API) : porte d'entrée HTTPS gérée ; valide le JWT ; coupe à 30 s
%%   (d'où les runs asynchrones). Les REST API offrent du streaming de réponse jusqu'à 15 min.
%% AWS Lambda : code exécuté à la demande (15 min max). API FastAPI, dispatcher, validation d'import, outils.
%% Amazon Bedrock : accès par API aux modèles (Claude Sonnet / Haiku, Titan Embeddings).
%%   Structured outputs : réponse conforme à un schéma JSON (remplace le toolChoice forcé).
%% Bedrock Prompt Management (option) : prompts versionnés avec variables, déployés par version.
%% Bedrock AgentCore Runtime : héberge les agents (conteneur géré, une session isolée par analyse).
%% Strands Agents (bibliothèque open source d'AWS, pas un service) : agents, outils, graphe, hooks.
%% AgentCore Memory : mémoire court terme (session) et long terme (préférences) par utilisateur.
%% AgentCore Gateway : expose des Lambdas / API comme outils MCP partagés, avec authentification.
%% AgentCore Policy (option) : règles Cedar évaluées à la Gateway pour autoriser / refuser un outil.
%% Bedrock Knowledge Bases : RAG géré (ingestion, découpage, embeddings, recherche avec filtres).
%% Amazon S3 Vectors : stockage et recherche de vecteurs dans S3, peu coûteux ; index de la KB.
%% Amazon DynamoDB : base NoSQL clé-valeur sans serveur. Profils, runs, événements, preuves.
%% Bedrock Guardrails : filtres configurables (sujets refusés, attaque d'invite, données personnelles,
%%   ancrage contextuel) sur les entrées et sorties des modèles.
%% AgentCore Observability : traces OpenTelemetry des agents vers CloudWatch (vue GenAI observability).
%% Amazon CloudWatch : journaux, métriques, tableaux de bord, alarmes.
%% AWS IAM : rôles et permissions ; un rôle à droits minimaux par composant.
%% Hors schéma : AWS CDK (infra en code) · Secrets Manager (clés d'API) ·
%%   Step Functions + EventBridge Scheduler (pipeline de données) · Glue + Athena (SQL sur S3).
%% =====================================================================================

%% AlphaForge — agent architecture (diagram v2)
%% Links and nodes are UNCHANGED. Lines starting with "%%" are comments:
%% Mermaid does not render them. For each link, they list the AWS tools used.
%% Glossary of AWS tools (1-2 lines each): at the bottom of this file.
%% Details and alternatives: docs/AWS.md · Link-by-link explanation: docs/ARCHITECTURE.md
%% Color legend: orange = AWS service · green = LLM agent · blue = deterministic code
%%                 violet = JSON data · white = interface
%% =====================================================================================
flowchart TB
  %% ===== 1. Frontend =====
  %% AWS: ECS on Fargate (recommended: ECS Express Mode) · ALB · Cognito · S3 (presigned URLs)
  UI["① Frontend — Streamlit on ECS Fargate · Cognito login<br/>chat · profile form · file upload (presigned S3 URL)"]

  %% ===== 2. API =====
  %% AWS: API Gateway (HTTP API + Cognito JWT authorizer) · Lambda (FastAPI + Mangum)
  API["② API Gateway HTTP + Lambda (FastAPI)<br/>POST /v1/runs → 202 run_id · GET /v1/runs/id"]

  %% ===== 3. Intake =====
  %% AWS: Bedrock (Claude Haiku, Converse API + structured outputs JSON Schema) · Guardrails (input)
  subgraph INTAKE["③ Intake — Bedrock Haiku, structured output (Pydantic)"]
    ING["Intake agent (ingester)<br/>free text → validated JSON"]
    PROF[/"Profile JSON<br/>risk band · horizon · ESG / crypto prefs<br/>language · experience · agent toggles"/]
    REQ[/"Request JSON<br/>task · assets · weights · capital · as_of"/]
  end

  %% ===== 4. Context =====
  %% AWS: Lambda (plain Python code) · S3 or Bedrock Prompt Management (versioned templates)
  subgraph CTX["④ Context resolution — deterministic code, no LLM"]
    PLAN{{"Plan resolver<br/>task × profile × toggles → enabled sub-agents"}}
    LOAD{{"Prompt loader<br/>base prompts by language · experience · role<br/>(versioned agent.md templates in S3)"}}
  end

  %% ===== 5. Agents =====
  %% AWS: Bedrock AgentCore Runtime (hosts the Strands graph) · Bedrock (Sonnet, Haiku) · AgentCore Memory
  subgraph RT["⑤ Amazon Bedrock AgentCore Runtime — Strands graph"]
    ORCH["Main agent · orchestrator<br/>Claude Sonnet"]
    MEM[("AgentCore Memory<br/>session · soft preferences")]
    subgraph SUB["Sub-agents · Claude Haiku · only the ones in the plan (run in parallel)"]
      RISK["Risk"]
      NEWS["News"]
      ESG["ESG"]
      FUND["Fundamentals"]
      MACRO["Macro & scenarios"]
      ALLOC["Allocation"]
    end
    GOV["Governance agent<br/>rules YAML → PASS / WARN / BLOCK"]
    EXP["Explainer agent · Claude Sonnet<br/>cites evidence only + claim verifier"]
  end

  %% ===== 6. Tools & data =====
  %% AWS: AgentCore Gateway (MCP) · Lambda · Bedrock Knowledge Bases · S3 Vectors · S3 · DynamoDB
  subgraph DATA["⑥ Tools & data"]
    GW["AgentCore Gateway (MCP)<br/>Lambda quant tools: metrics · risk · scenarios · optimizer"]
    KB["Bedrock Knowledge Base<br/>news & docs · S3 Vectors"]
    S3[("S3 curated Parquet<br/>prices · FX · macro · point-in-time")]
    DDB[("DynamoDB<br/>profiles · runs · evidence ledger")]
  end

  %% AWS: same frontend service (ECS); reads the result via API Gateway + Lambda
  OUT["⑦ Frontend result view<br/>short answer · clickable evidence · checks · trace"]

  %% ===== Cross-cutting =====
  %% AWS: Bedrock Guardrails · AgentCore Observability → CloudWatch (GenAI observability) · IAM
  X["Cross-cutting: Bedrock Guardrails (inputs & outputs) · AgentCore Observability → CloudWatch · IAM least privilege"]

  %% ===== Flow =====
  %% L1  UI → API: Cognito issues the JWT; the API Gateway JWT authorizer validates it before the Lambda.
  %%      Files go straight to S3 via presigned URL (never through Lambda, 6 MB limit).
  UI -->|"JWT"| API
  %% L2  API → Intake: Lambda calls Bedrock (Haiku) with structured outputs (JSON schema), via the anthropic
  %%      SDK (AnthropicBedrock client = InvokeModel, messages.parse, inference profile us.anthropic.claude-haiku-5-5);
  %%      code: backend/app/intake/. Guardrails filters the input (prompt attack, personal data): ApplyGuardrail
  %%      when AF_GUARDRAIL_ID is set. Offline mode without an LLM (AF_INTAKE_MODE=mock) for tests and demos.
  API --> ING
  %% L3  Intake → JSON: output validated by schema (Bedrock structured outputs), then Pydantic;
  %%      the profile is stored in DynamoDB (ACTOR#… / PROFILE#…).
  ING --> PROF
  ING --> REQ
  %% L4  JSON → Plan resolver: Lambda, plain Python code; versioned agent/task registry (repo, or AWS AppConfig as an option).
  PROF --> PLAN
  REQ --> PLAN
  %% L5  Profile → Prompt loader: Lambda; picks the Explainer template (experience level). Source: Git
  %%      (agents/prompts/), published to S3 in aws mode (AF_PROMPT_SOURCE); option: Bedrock Prompt Management.
  PROF --> LOAD
  %% L6  Plan → Orchestrator: DynamoDB (run QUEUED) → "dispatcher" Lambda (asynchronous invocation)
  %%      → AgentCore Runtime (InvokeAgentRuntime). API / agents boundary; IAM for the call.
  PLAN -->|"ExecutionPlan"| ORCH
  %% L7  Prompt loader → Explainer: only keys travel (level, version) in the payload
  %%      InvokeAgentRuntime; the Runtime loads the template from S3 / Prompt Management.
  LOAD -.->|"prompts"| EXP
  %% L8  Orchestrator → Sub-agents: Strands graph in AgentCore Runtime; Bedrock models (Haiku);
  %%      only the agents in the plan become nodes, running in parallel.
  ORCH -->|"dispatch"| SUB
  %% L9  Sub-agents → Governance: in memory inside the Runtime; Python rules (YAML); no external service.
  SUB -->|"findings"| GOV
  %% L10 Governance → Orchestrator: conditional edge of the Strands graph (max 2 loops), inside the Runtime.
  GOV -->|"BLOCK → fix (max 2 loops)"| ORCH
  %% L11 Governance → Explainer: inside the Runtime; coded findings + checks + disabled agents.
  GOV -->|"PASS / WARN"| EXP
  %% L12 Sub-agents → Gateway: AgentCore Gateway (MCP, SigV4/OAuth auth, optional Cedar Policy)
  %%      → quant tool Lambdas.
  SUB -->|"tool calls"| GW
  %% L13 News → KB: Bedrock Knowledge Bases (Retrieve API + metadata filter published ≤ as_of),
  %%      S3 Vectors index, Titan Text Embeddings v2 embeddings.
  NEWS -->|"RAG · published ≤ as_of"| KB
  %% L14 Gateway → S3: the tool Lambdas read the Parquet files (pandas/DuckDB, point-in-time filter).
  %%      Glue + Athena are for exploration, not for this loop.
  GW --> S3
  %% L15 Gateway → DynamoDB: in practice, a Strands hook (AfterToolCallEvent) in the Runtime writes
  %%      each tool result as evidence (RUN#id / EVID#ev-<hash>).
  GW -->|"each call = 1 evidence"| DDB
  %% L16 DynamoDB → Explainer: reads (Query) the evidence ledger via the get_evidence tool.
  DDB -.->|"evidence ledger"| EXP
  %% L17 Orchestrator ↔ Memory: AgentCore Memory (short term: session; long term: preferences
  %%      per actorId) via the Strands session manager.
  ORCH <-.-> MEM
  %% L18 Explainer → DynamoDB: RunResult written (S3 if > 400 KB); Guardrails grounding check
  %%      on the short answer.
  EXP -->|"RunResult"| DDB
  %% L19 Explainer → Result view: in practice the frontend polls GET /v1/runs/{id} (API Gateway + Lambda
  %%      that reads DynamoDB). Option: API Gateway REST with response streaming (SSE) for progress.
  EXP -->|"GET /v1/runs/id (poll)"| OUT

  classDef aws fill:#fff4e5,stroke:#e88a1a,color:#1f1f1f;
  classDef det fill:#eaf2ff,stroke:#3b6fd8,color:#1f1f1f;
  classDef agent fill:#eaf8ee,stroke:#2f9e55,color:#1f1f1f;
  classDef json fill:#f6f0ff,stroke:#8a63d2,color:#1f1f1f;
  classDef ui fill:#ffffff,stroke:#555,color:#1f1f1f;
  class API,GW,KB,S3,DDB,MEM,X aws;
  class PLAN,LOAD det;
  class ING,ORCH,RISK,NEWS,ESG,FUND,MACRO,ALLOC,GOV,EXP agent;
  class PROF,REQ json;
  class UI,OUT ui;

%% =====================================================================================
%% GLOSSARY OF AWS TOOLS (summary; details, regions and alternatives: docs/AWS.md)
%% -------------------------------------------------------------------------------------
%% Amazon ECS on Fargate: runs containers without managing servers. Hosts Streamlit.
%%   ECS Express Mode creates the Fargate service, the ALB, the HTTPS URL and autoscaling in one call.
%% Application Load Balancer (ALB): spreads HTTPS traffic to the Streamlit container.
%% Amazon Cognito: user directory; issues the JWT tokens (pseudonymous identity = actor_id).
%% Amazon S3: object storage. Uploaded files (presigned URLs), curated Parquet, prompt templates.
%% Amazon API Gateway (HTTP API): managed HTTPS entry point; validates the JWT; times out at 30 s
%%   (hence the asynchronous runs). REST APIs offer response streaming up to 15 min.
%% AWS Lambda: on-demand code (15 min max). FastAPI API, dispatcher, upload validation, tools.
%% Amazon Bedrock: API access to models (Claude Sonnet / Haiku, Titan Embeddings).
%%   Structured outputs: response that conforms to a JSON schema (replaces forced toolChoice).
%% Bedrock Prompt Management (option): versioned prompts with variables, deployed by version.
%% Bedrock AgentCore Runtime: hosts the agents (managed container, one isolated session per analysis).
%% Strands Agents (AWS open-source library, not a service): agents, tools, graph, hooks.
%% AgentCore Memory: short-term (session) and long-term (preferences) memory per user.
%% AgentCore Gateway: exposes Lambdas / APIs as shared MCP tools, with authentication.
%% AgentCore Policy (option): Cedar rules evaluated at the Gateway to allow / deny a tool.
%% Bedrock Knowledge Bases: managed RAG (ingestion, chunking, embeddings, search with filters).
%% Amazon S3 Vectors: low-cost vector storage and search in S3; KB index.
%% Amazon DynamoDB: serverless key-value NoSQL database. Profiles, runs, events, evidence.
%% Bedrock Guardrails: configurable filters (denied topics, prompt attack, personal data,
%%   contextual grounding) on model inputs and outputs.
%% AgentCore Observability: OpenTelemetry traces from the agents to CloudWatch (GenAI observability view).
%% Amazon CloudWatch: logs, metrics, dashboards, alarms.
%% AWS IAM: roles and permissions; one least-privilege role per component.
%% Not in the diagram: AWS CDK (infrastructure as code) · Secrets Manager (API keys) ·
%%   Step Functions + EventBridge Scheduler (data pipeline) · Glue + Athena (SQL on S3).
%% =====================================================================================

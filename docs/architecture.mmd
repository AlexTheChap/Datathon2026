flowchart TB
  %% ===== 1. Frontend =====
  %% AWS: ECS on Fargate (recommended: ECS Express Mode) · ALB · Cognito · S3 (presigned URLs)
  UI["① Frontend — Streamlit on ECS Fargate · Cognito login<br/>chat · profile form · file upload (presigned S3 URL)"]

  %% ===== 2. API =====
  %% AWS: API Gateway (HTTP API + Cognito JWT authorizer) · Lambda (FastAPI + Mangum)
  API["② API Gateway HTTP + Lambda (FastAPI)<br/>POST /v1/runs → 202 run_id · GET /v1/runs/id"]

  %% ===== 3. Intake =====
  %% AWS: Bedrock (Claude Haiku, Converse API + structured outputs JSON Schema) · Guardrails (input)
  subgraph INTAKE["③ Intake — Bedrock Haiku, structured output (Pydantic)"]
    ING["Intake agent (ingester)<br/>free text → validated JSON"]
    PROF[/"Profile JSON<br/>risk band · horizon · ESG / crypto prefs<br/>language · experience · agent toggles"/]
    REQ[/"Request JSON<br/>task · assets · weights · capital · as_of"/]
  end

  %% ===== 4. Context =====
  %% AWS: Lambda (plain Python code) · S3 or Bedrock Prompt Management (versioned templates)
  subgraph CTX["④ Context resolution — deterministic code, no LLM"]
    PLAN{{"Plan resolver<br/>task × profile × toggles → enabled sub-agents"}}
    LOAD{{"Prompt loader<br/>base prompts by language · experience · role<br/>(versioned agent.md templates in S3)"}}
  end

  %% ===== 5. Agents =====
  %% AWS: Bedrock AgentCore Runtime (hosts the Strands graph) · Bedrock (Sonnet, Haiku) · AgentCore Memory
  subgraph RT["⑤ Amazon Bedrock AgentCore Runtime — Strands graph"]
    ORCH["Main agent · orchestrator<br/>Claude Sonnet"]
    MEM[("AgentCore Memory<br/>session · soft preferences")]
    subgraph SUB["Sub-agents · Claude Haiku · enabled per profile toggles (plan) · agents-as-tools (graph = next phase)"]
      RISK["Risk"]
      NEWS["News (SIMULATED)"]
      ESG["ESG"]
      FUND["Fundamentals"]
      MACRO["Macro & scenarios"]
      ALLOC["Allocation<br/>(self-verifies via GOV)"]
    end
    GOV["Governance check — deterministic<br/>rules.yaml → PASS / WARN / BLOCK"]
    EXP["Explainer agent · Claude Sonnet<br/>cites evidence only + claim verifier"]
  end

  %% ===== 6. Tools & data =====
  %% AWS: AgentCore Gateway (MCP) · Lambda · Bedrock Knowledge Bases · S3 Vectors · S3 · DynamoDB
  subgraph DATA["⑥ Tools & data"]
    GW["AgentCore Gateway (MCP)<br/>Lambda quant tools: metrics · stress · concentration · correlation<br/>risk_contribution · max_position · macro · rates · esg_screen · optimizer (later)"]
    KB["Bedrock Knowledge Base<br/>news & docs · S3 Vectors"]
    S3[("S3 curated Parquet<br/>prices · FX · macro · point-in-time")]
    DDB[("DynamoDB<br/>profiles · runs · evidence ledger")]
  end

  %% AWS: same frontend service (ECS); reads the result via API Gateway + Lambda
  OUT["⑦ Frontend result view<br/>short answer · clickable evidence · checks · trace"]

  %% ===== Cross-cutting =====
  %% AWS: Bedrock Guardrails · AgentCore Observability → CloudWatch (GenAI observability) · IAM
  X["Cross-cutting: Bedrock Guardrails (inputs & outputs) · AgentCore Observability → CloudWatch · IAM least privilege"]

  %% ===== Flow =====
  %% L1  UI → API: Cognito issues the JWT; the API Gateway JWT authorizer validates it before the Lambda.
  %%      Files go straight to S3 via presigned URL (never through Lambda, 6 MB limit).
  UI -->|"JWT"| API
  %% L2  API → Intake: Lambda calls Bedrock (Haiku) via Converse with structured outputs (JSON schema).
  %%      Guardrails filters the input (prompt attack, personal data).
  API --> ING
  %% L3  Intake → JSON: output validated by schema (Bedrock structured outputs), then Pydantic;
  %%      the profile is stored in DynamoDB (ACTOR#… / PROFILE#…).
  ING --> PROF
  ING --> REQ
  %% L4  JSON → Plan resolver: Lambda, plain Python code; versioned agent/task registry (repo, or AWS AppConfig as an option).
  PROF --> PLAN
  REQ --> PLAN
  %% L5  Profile → Prompt loader: Lambda; picks the Explainer template (experience level). Source: Git
  %%      (agents/prompts/), published to S3 in aws mode (AF_PROMPT_SOURCE); option: Bedrock Prompt Management.
  PROF --> LOAD
  %% L6  Plan → Orchestrator: DynamoDB (run QUEUED) → "dispatcher" Lambda (asynchronous invocation)
  %%      → AgentCore Runtime (InvokeAgentRuntime). API / agents boundary; IAM for the call.
  PLAN -->|"ExecutionPlan"| ORCH
  %% L7  Prompt loader → Explainer: only keys travel (level, version) in the payload
  %%      InvokeAgentRuntime; the Runtime loads the template from S3 / Prompt Management.
  LOAD -.->|"prompts"| EXP
  %% L8  Orchestrator → Sub-agents: TARGET: Strands graph in AgentCore Runtime, plan-driven
  %%      parallel nodes. CURRENT: agents-as-tools — ORCH calls each <domain>_subagent
  %%      tool with a structured payload (subject + weights + tickers); the investor
  %%      context is rendered into the brief by deterministic code (render_brief).
  ORCH -->|"dispatch (agents-as-tools)"| SUB
  %% L9  Governance: TARGET (graph phase): sub-agent findings verified by the GOV node.
  %%      CURRENT: governance_check is a deterministic TOOL (pure-Python rules, no LLM):
  %%      ORCH calls it on weights (reference verdict), and ALLOC self-verifies its
  %%      proposal by iterating until PASS/WARN — L10's "BLOCK → fix" loop, implemented.
  ORCH -->|"governance_check (tool)"| GOV
  ALLOC -->|"self-verify loop"| GOV
  %% L10 Governance → caller: the verdict returns to whoever called the tool (ORCH or ALLOC);
  %%      max 2 loops implemented inside ALLOC's iterate-to-PASS.
  GOV -->|"verdict (PASS / WARN / BLOCK)"| ORCH
  %% L11 Governance → Explainer: inside the Runtime; coded findings + checks + disabled agents.
  GOV -->|"PASS / WARN"| EXP
  %% L12 Sub-agents → Tools: TARGET: AgentCore Gateway (MCP, SigV4/OAuth auth, optional Cedar
  %%      Policy) → quant tool Lambdas. CURRENT: direct in-process calls — sub-agents own their
  %%      domain toolsets (risk: metrics/stress/concentration/correlation/risk_contribution/
  %%      max_position · macro: macro_snapshot/rate_sensitivity/stress · esg+fundamentals:
  %%      esg_screen · allocation: metrics/max_position/stress/concentration/governance_check).
  SUB -->|"tool calls (in-process)"| GW
  %% L13 News → KB: TARGET: Bedrock Knowledge Bases (Retrieve API + metadata filter published
  %%      ≤ as_of), S3 Vectors index. CURRENT: news_subagent is a SIMULATED placeholder (no
  %%      feed, no licence) — content labeled fictional end to end.
  NEWS -.->|"RAG · published ≤ as_of (later)"| KB
  %% L14 Tools → Data: TARGET: Gateway Lambdas read S3 Parquet (pandas/DuckDB, point-in-time).
  %%      CURRENT: in-process pandas reads over data/curated CSVs (returns_daily_cad,
  %%      macro_daily_asof, rate_sensitivity, esg_index_screen, controversies…).
  GW --> S3
  %% L15 Tools → Evidence ledger: a Strands hook (AfterToolCallEvent) fires after every tool
  %%      call. TARGET sink: DynamoDB (RUN#id / EVID#E-001). CURRENT: local JSONL ledger
  %%      data/runs/<run_id>.jsonl behind the same EvidenceLedger interface — every call is
  %%      one record (seq, caller agent tag, tool, inputs, envelope), incl. nested sub-agent
  %%      calls and failures. Viewer: scripts/show_run.py.
  GW -->|"each call = 1 evidence"| DDB
  %% L16 DynamoDB → Explainer: reads (Query) the evidence ledger via the get_evidence tool.
  DDB -.->|"evidence ledger"| EXP
  %% L17 Orchestrator ↔ Memory: AgentCore Memory (short term: session; long term: preferences
  %%      per actorId) via the Strands session manager.
  ORCH <-.-> MEM
  %% L18 Explainer → DynamoDB: RunResult written (S3 if > 400 KB); Guardrails grounding check
  %%      on the short answer.
  EXP -->|"RunResult"| DDB
  %% L19 Explainer → Result view: in practice the frontend polls GET /v1/runs/{id} (API Gateway + Lambda
  %%      that reads DynamoDB). Option: API Gateway REST with response streaming (SSE) for progress.
  EXP -->|"GET /v1/runs/id (poll)"| OUT

